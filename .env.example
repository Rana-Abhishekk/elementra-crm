# Copy to .env and fill in. Never commit real secrets.
# Postgres connection string (Neon in production, any Postgres locally)
DATABASE_URL=
NEXTAUTH_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=

# First admin account, created by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@elementra.local
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME="Elementra Admin"

# Print every SQL query in the dev server terminal (slow; for debugging only)
PRISMA_LOG_QUERIES=
